{
  "name": "@scorpion/web",
  "version": "0.0.0",
  "license": "ISC",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "start": "node src/front/main.ts"
  },
  "dependencies": {
    "@scorpion/contracts": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@guidepup/guidepup": "0.40.0",
    "@guidepup/playwright": "0.21.0",
    "@guidepup/setup": "0.29.3",
    "@hono/node-server": "^2.1.11",
    "@playwright/test": "^1.65.1",
    "@scalar/api-reference": "1.82.1",
    "@scalar/sveltekit": "0.3.40",
    "@scorpion/core-audit": "workspace:*",
    "@scorpion/core-identity": "workspace:*",
    "@scorpion/core-notifications": "workspace:*",
    "@scorpion/core-ui-shell": "workspace:*",
    "@scorpion/kernel": "workspace:*",
    "@scorpion/kpi-analytics": "workspace:*",
    "@scorpion/kpi-framework": "workspace:*",
    "@scorpion/kpi-impact": "workspace:*",
    "@scorpion/kpi-ingestion": "workspace:*",
    "@scorpion/matomo": "workspace:*",
    "@scorpion/registry-organisations": "workspace:*",
    "@scorpion/registry-services": "workspace:*",
    "@scorpion/testing": "workspace:*",
    "@scorpion/ui-kit": "workspace:*",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/pg": "^8.23.1",
    "daisyui": "^5.8.2",
    "pg": "^8.23.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "write-excel-file": "4.1.1"
  }
}
