{
  "name": "@scorpion/web",
  "version": "0.0.0",
  "license": "ISC",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "start": "node src/front/main.ts"
  },
  "dependencies": {
    "@scorpion/contracts": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@hono/node-server": "^2.1.3",
    "@playwright/test": "^1.63.0",
    "@scorpion/core-audit": "workspace:*",
    "@scorpion/core-identity": "workspace:*",
    "@scorpion/core-notifications": "workspace:*",
    "@scorpion/core-ui-shell": "workspace:*",
    "@scorpion/kernel": "workspace:*",
    "@scorpion/testing": "workspace:*",
    "@scorpion/ui-kit": "workspace:*",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "daisyui": "^5.7.47",
    "pg": "^8.23.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
