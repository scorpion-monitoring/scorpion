{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "e2e/**/*.ts",
    "e2e/**/*.svelte",
    "vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
