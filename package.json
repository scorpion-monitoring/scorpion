{
  "name": "scorpion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "dev": "docker compose -f docker-compose.dev.yml up -d --wait && pnpm --parallel --filter @scorpion/server --filter @scorpion/web dev",
    "build": "node scripts/build.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && pnpm --filter @scorpion/web check",
    "test": "node scripts/test.ts",
    "test:contract": "node scripts/not-yet.ts M8 test:contract",
    "test:e2e": "pnpm --filter @scorpion/web test:e2e",
    "db:generate": "node scripts/not-yet.ts M1 db:generate",
    "scorpion": "node scripts/not-yet.ts M1 scorpion"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@scorpion/eslint-plugin": "workspace:*",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
