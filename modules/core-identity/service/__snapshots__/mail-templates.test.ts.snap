exports[`the identity templates > identity.registration-request in en renders as before (snapshot) 1`] = `
{
  "html": "<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Registration request from Ada Lovelace</title></head><body style="margin:0;padding:24px;background:#f4f5f7;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1f2933;"><div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:32px;"><p style="margin:0 0 24px;"><img src="https://example.org/api/internal/files/abc" alt="Test Instance" style="max-height:48px;max-width:240px;"></p><h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">A registration waits for review</h1><p style="margin:0 0 16px;font-size:16px;line-height:1.5;">Ada Lovelace (Ada Lovelace) registered on Test Instance and waits for approval.</p><p style="margin:0 0 16px;font-size:16px;line-height:1.5;"><a href="https://example.org/admin/users/pending" style="display:inline-block;padding:12px 20px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">Review registrations</a></p><p style="margin:0 0 16px;font-size:13px;line-height:1.5;color:#52606d;">If the button does not work, copy this link into your browser:<br><a href="https://example.org/admin/users/pending">https://example.org/admin/users/pending</a></p><p style="margin:24px 0 0;font-size:12px;line-height:1.5;color:#7b8794;">This message was sent by Test Instance.<br>Questions? Write to help@example.org.<br><a href="https://example.org/imprint">Imprint</a></p></div></body></html>",
  "subject": "Registration request from Ada Lovelace",
  "text": "A registration waits for review

Ada Lovelace (Ada Lovelace) registered on Test Instance and waits for approval.

Review registrations:
https://example.org/admin/users/pending

--
This message was sent by Test Instance.
Questions? Write to help@example.org.
Imprint: https://example.org/imprint
",
}
`;

