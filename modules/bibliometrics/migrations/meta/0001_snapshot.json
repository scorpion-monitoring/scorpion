        },
        "biblio_doi_metadata_authors_check": {
          "name": "biblio_doi_metadata_authors_check",
          "value": "jsonb_typeof(\"biblio_doi_metadata\".\"authors\") = 'array' and jsonb_array_length(\"biblio_doi_metadata\".\"authors\") <= 100"
        },
        "biblio_doi_metadata_issued_check": {
          "name": "biblio_doi_metadata_issued_check",
          "value": "(\"biblio_doi_metadata\".\"issued\" is null) = (\"biblio_doi_metadata\".\"issued_precision\" is null) and (\"biblio_doi_metadata\".\"issued_precision\" is null or \"biblio_doi_metadata\".\"issued_precision\" in ('year', 'month', 'day'))"
