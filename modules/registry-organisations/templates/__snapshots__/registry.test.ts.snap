  "html": "<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Your membership of Ada Lovelace was approved</title></head><body style="margin:0;padding:24px;background:#f4f5f7;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;color:#1f2933;"><div style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;padding:32px;"><p style="margin:0 0 24px;"><img src="https://example.org/api/internal/files/abc" alt="Test Instance" style="max-height:48px;max-width:240px;"></p><h1 style="margin:0 0 16px;font-size:20px;line-height:1.3;">You are a member of Ada Lovelace</h1><p style="margin:0 0 16px;font-size:16px;line-height:1.5;">Your request was approved. You can now work with the services of Ada Lovelace.</p><p style="margin:0 0 16px;font-size:16px;line-height:1.5;">Note:<br>Ada Lovelace</p><p style="margin:0 0 16px;font-size:16px;line-height:1.5;"><a href="https://example.org/somewhere" style="display:inline-block;padding:12px 20px;background:#1d4ed8;color:#ffffff;text-decoration:none;border-radius:6px;font-weight:600;">Open Ada Lovelace</a></p><p style="margin:0 0 16px;font-size:13px;line-height:1.5;color:#52606d;">If the button does not work, copy this link into your browser:<br><a href="https://example.org/somewhere">https://example.org/somewhere</a></p><p style="margin:24px 0 0;font-size:12px;line-height:1.5;color:#7b8794;">This message was sent by Test Instance.<br>Questions? Write to help@example.org.<br><a href="https://example.org/imprint">Imprint</a></p></div></body></html>",
