        },
        "org_organisation_description_check": {
          "name": "org_organisation_description_check",
          "value": "\"org_organisation\".\"description\" is null or char_length(\"org_organisation\".\"description\") <= 4000"
        },
        "org_organisation_website_check": {
          "name": "org_organisation_website_check",
          "value": "\"org_organisation\".\"website\" is null or (char_length(\"org_organisation\".\"website\") <= 500 and \"org_organisation\".\"website\" ~* '^https?://')"
        },
        "org_organisation_ror_id_check": {
          "name": "org_organisation_ror_id_check",
          "value": "\"org_organisation\".\"ror_id\" is null or \"org_organisation\".\"ror_id\" ~ '^0[a-hj-km-np-tv-z0-9]{6}[0-9]{2}$'"
        },
        "org_organisation_same_as_check": {
          "name": "org_organisation_same_as_check",
          "value": "cardinality(\"org_organisation\".\"same_as\") <= 20"
        },
        "org_organisation_contact_check": {
          "name": "org_organisation_contact_check",
          "value": "(\"org_organisation\".\"contact_email\" is null) = (\"org_organisation\".\"contact_type\" is null)\n        and (\"org_organisation\".\"contact_email\" is null or char_length(\"org_organisation\".\"contact_email\") <= 254)\n        and (\"org_organisation\".\"contact_type\" is null or char_length(\"org_organisation\".\"contact_type\") between 1 and 64)"
        },
        "org_organisation_logo_check": {
