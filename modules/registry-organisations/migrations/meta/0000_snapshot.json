      "checkConstraints": {
        "org_organisation_abbreviation_check": {
          "name": "org_organisation_abbreviation_check",
          "value": "char_length(\"org_organisation\".\"abbreviation\") between 1 and 64 and \"org_organisation\".\"abbreviation\" !~ '[[:space:]/]'"
        },
        "org_organisation_name_check": {
          "name": "org_organisation_name_check",
