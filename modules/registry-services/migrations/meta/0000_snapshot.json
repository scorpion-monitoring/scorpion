        "svc_service_slug_check": {
          "name": "svc_service_slug_check",
          "value": "char_length(\"svc_service\".\"slug\") between 1 and 64 and \"svc_service\".\"slug\" ~ '^[A-Za-z0-9][A-Za-z0-9._-]*$'"
        },
        "svc_service_name_check": {
          "name": "svc_service_name_check",
