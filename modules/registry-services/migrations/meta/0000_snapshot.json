        },
        "svc_service_description_check": {
          "name": "svc_service_description_check",
          "value": "\"svc_service\".\"description\" is null or char_length(\"svc_service\".\"description\") <= 4000"
        },
        "svc_service_url_check": {
          "name": "svc_service_url_check",
          "value": "\"svc_service\".\"url\" is null or (char_length(\"svc_service\".\"url\") <= 500 and \"svc_service\".\"url\" ~* '^https?://')"
        },
        "svc_service_same_as_check": {
          "name": "svc_service_same_as_check",
          "value": "cardinality(\"svc_service\".\"same_as\") <= 20"
        },
        "svc_service_contact_check": {
          "name": "svc_service_contact_check",
          "value": "(\"svc_service\".\"contact_email\" is null) = (\"svc_service\".\"contact_type\" is null)\n        and (\"svc_service\".\"contact_email\" is null or char_length(\"svc_service\".\"contact_email\") <= 254)\n        and (\"svc_service\".\"contact_type\" is null or char_length(\"svc_service\".\"contact_type\") between 1 and 64)"
        },
        "svc_service_icon_check": {
          "name": "svc_service_icon_check",
          "value": "(\"svc_service\".\"icon_blob_id\" is null) = (\"svc_service\".\"icon_hash\" is null)"
        },
        "svc_service_published_check": {
          "name": "svc_service_published_check",
          "value": "\"svc_service\".\"public\" = (\"svc_service\".\"published_at\" is not null)\n        and (\"svc_service\".\"published_at\" is null) = (\"svc_service\".\"published_by\" is null)"
        }
      },
