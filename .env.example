# Copy to .env for local development (`pnpm dev` does it for you when .env is missing).
# The server reads these variables; anything else is configuration in settings, not environment.

# Required. The PostgreSQL database; migrations run on start.
DATABASE_URL=postgres://scorpion:scorpion@localhost:5432/scorpion

# The deployment profile this build contains. `pnpm dev` regenerates the server for it.
PROFILE=full

# Port the server listens on.
PORT=3000

# Path the whole application is served under: "/" or "/a/b" (no trailing slash).
BASE_PATH=/

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# inline: the web process also runs jobs and the event dispatcher.
# separate: run them with `scorpion worker` in another process.
WORKER_MODE=inline

# The public origin, without a path: https://scorpion.example.org (default: http://localhost:PORT).
ORIGIN=http://localhost:3000

# The reverse proxies in front of the server (IPs or CIDR ranges, comma-separated). The rate limit
# reads the client address from X-Forwarded-For only when the request comes from one of them.
# Leave empty when clients connect directly. Example: 10.0.0.0/8,fd00::/8
TRUSTED_PROXIES=

# Required by every profile that includes core.settings (all but the empty ones): the key that encrypts
# the stored secrets (OIDC client secrets), AES-256-GCM. 32 random bytes, base64. Generate one with
#   openssl rand -base64 32
# `pnpm dev` generates one into .env for you. Keep it safe and back it up with the database: without it
# the stored secrets cannot be read. Never put it in settings, a log or a ticket.
SECRETS_KEY=

# Only while rotating the key (`scorpion rotate-secrets`): the new key. Leave empty otherwise. The steps
# are in modules/core-settings/README.md ("Rotating the key").
SECRETS_KEY_NEXT=

# OIDC client secrets are not read from the environment any more: store each one in the encrypted
# secrets store with `scorpion set-secret oidc.<provider id>.client-secret` (the value is asked for, or
# read from standard input). Without one the provider's client is a public client (PKCE only). The
# providers themselves (issuer, client id, scopes) are settings. Register
# <ORIGIN><BASE_PATH>/api/internal/auth/oidc/<id>/callback as the redirect URI at the provider.

# Where core.identity sends password-reset and email-verification mails (the dev Mailpit; web UI on
# http://localhost:8025). Unset: no mail is sent and the log says so. core.notifications (M4) reuses it.
SMTP_URL=smtp://localhost:1025
